DATABASE_URL=postgresql://taiwanhub:taiwanhub@localhost:5432/taiwanhub
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_MAPBOX_TOKEN=
IMAGE_STORAGE_PROVIDER=local
IMAGE_STORAGE_PUBLIC_URL=
IMAGE_STORAGE_BUCKET=
IMAGE_STORAGE_REGION=auto
IMAGE_STORAGE_ENDPOINT=
IMAGE_STORAGE_ACCESS_KEY_ID=
IMAGE_STORAGE_SECRET_ACCESS_KEY=
ANALYTICS_CONSOLE=true
FEATURE_PRODUCTS=true
FEATURE_ORGANIZATIONS=true
FEATURE_SUBMISSIONS=true
# Map-first home, personal/group layer writes and local content. Set false to roll back.
FEATURE_MAP_HOME=true
FEATURE_LAYER_WRITES=true
FEATURE_CONTENT=true
# Invitation-only membership (docs/invitation-membership-implementation-plan.md).
# closed = no new accounts at all; invite_only = the invitation flow is live.
# Both keep existing logins working. Unset/unknown values behave as "closed".
MEMBERSHIP_MODE=closed
# true pauses new approvals/invites without affecting already-issued ones.
MEMBERSHIP_ISSUANCE_PAUSED=false
# Mail transport (docs/deployment.md, "Membership email"). Leave MAIL_PROVIDER
# unset locally for the in-memory dev/test transport. `resend` needs
# RESEND_API_KEY and a verified MAIL_FROM such as "TaiwanHub <hello@example.com>".
# Production refuses the test and capture transports; email sign-in and
# invitation delivery stay unavailable until a real provider is configured.
MAIL_PROVIDER=
MAIL_FROM=
RESEND_API_KEY=
# Browser tests only: MAIL_PROVIDER=capture writes encrypted messages under this
# directory, which must be inside the OS temp directory. Never set in production.
MAIL_CAPTURE_DIR=
# Request header carrying the client IP set by your platform (Vercel:
# x-vercel-forwarded-for). Unset = no per-IP limits; per-email limits still apply.
TRUSTED_CLIENT_IP_HEADER=
# 32 random bytes, base64-encoded (e.g. `openssl rand -base64 32`). Encrypts
# mail_outbox payloads at rest; rotate by adding a new key version in code.
MAIL_OUTBOX_ENCRYPTION_KEY=
# Google Places UI Kit + TaiwanHub reviews (docs/google-places-implementation-plan.md).
# All off by default. The UI Kit key is intentionally browser-visible: restrict it
# by referrer and API in Google Cloud; never reuse GOOGLE_CLIENT_* or a server key.
NEXT_PUBLIC_GOOGLE_PLACES_UI_KIT_KEY=
FEATURE_GOOGLE_PLACES_DISCOVERY=false
FEATURE_PLACE_REVIEW_WRITES=false
FEATURE_EXTERNAL_PLACE_COLLECTIONS=false
FEATURE_MAP_EFFECTS=false
# Member-created places in private/group layers (docs/plans/layer-scoped-places-design.md).
FEATURE_LAYER_CUSTOM_PLACES=false
# Server-only Places API (New) key for resolving pasted Google Maps links
# (IDs-only Text Search). Restrict it by API and add a daily quota; keep it
# separate from the UI Kit key and the worker's GOOGLE_PLACES_SERVER_API_KEY.
# `fake` selects the deterministic test resolver outside production.
GOOGLE_MAPS_LINK_API_KEY=
# Instagram imports: separate Playwright + local Ollama worker. Server-only.
# Leave URL empty to disable. Same machine: http://127.0.0.1:11435
# Remote deployments require an operator-managed HTTPS worker origin.
INSTAGRAM_WORKER_URL=
# Same random secret (at least 32 characters) on web server and worker.
INSTAGRAM_WORKER_TOKEN=
# Worker only: choose an installed LOCAL model (ollama list), never a cloud alias.
INSTAGRAM_OLLAMA_MODEL=
# Send places from chat (docs/guides/chat-capture-setup.md). Off unless "true";
# also needs layer writes. Server-only secrets.
FEATURE_CHAT_CAPTURE=false
# LINE Messaging API channel (LINE Developers console > Messaging API tab).
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Public add-friend link of the official account, e.g. https://line.me/R/ti/p/@yourid
LINE_ADD_FRIEND_URL=
# Instagram API with Instagram Login (Meta app dashboard).
INSTAGRAM_APP_SECRET=
# A random string of at least 16 characters, also entered in the Meta webhook settings.
INSTAGRAM_VERIFY_TOKEN=
# Long-lived Instagram User access token of the professional account.
INSTAGRAM_ACCESS_TOKEN=
# Account handle without "@", used for the ig.me chat link.
INSTAGRAM_ACCOUNT_HANDLE=
# Graph API version for sending replies; defaults to v26.0.
INSTAGRAM_GRAPH_VERSION=
# Tests only: "capture" writes bot replies to MESSAGING_CAPTURE_DIR (never in production).
MESSAGING_PROVIDER=
MESSAGING_CAPTURE_DIR=
# Daily restaurant recommendation, version 2
# (docs/plans/daily-restaurant-recommendation-implementation-plan.md).
# Off by default; a real run also needs a per-area restaurant_discovery_area.enabled
# row and the pending Phase 0 provider/retention ADR, regardless of these flags.
FEATURE_RESTAURANT_DISCOVERY_WORKER=false
RESTAURANT_PROVIDER_POLICY_APPROVED=false
FEATURE_RESTAURANT_AUTO_PUBLISH=false
# Server-only; never expose in NEXT_PUBLIC_*. Required only once the ADR above
# is approved and an area is explicitly enabled for a live (non-fake) run.
GOOGLE_PLACES_SERVER_API_KEY=
DAILY_PICK_LLM_MODEL=
