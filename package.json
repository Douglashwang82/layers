{
  "name": "taiwanhub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "pnpm --filter @taiwanhub/web dev",
    "build": "pnpm --filter @taiwanhub/web build",
    "start": "pnpm --filter @taiwanhub/web start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx packages/database/src/migrate.ts",
    "db:seed": "tsx packages/database/src/seed.ts",
    "admin:grant": "tsx packages/database/src/grant-admin.ts",
    "ingest": "tsx packages/database/src/ingestion-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@hookform/resolvers": "^5.2.2",
    "@taiwanhub/database": "workspace:*",
    "@taiwanhub/shared": "workspace:*",
    "better-auth": "1.7.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.577.0",
    "mapbox-gl": "^3.30.0",
    "next": "16.3.5",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "esbuild@<=0.24.2": "^0.25.12"
    }
  }
}
